# Rename this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# Anthropic — claude.ai/settings
ANTHROPIC_API_KEY=

# Tavily — app.tavily.com (free tier: 1,000 searches/month)
TAVILY_API_KEY=

# Gmail — Google Account → Security → 2-Step Verification → App Passwords
# Use the 16-char App Password, not your Gmail login password
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Newsletter sender identity
NEWSLETTER_FROM_NAME=Your Newsletter Name
NEWSLETTER_SENDER_ADDRESS=City, Country

# Google Sheets — subscriber list
# Column headers must be: name | email | subscribed (TRUE/FALSE)
# Share the sheet with your service account email from credentials.json
GOOGLE_SHEETS_SUBSCRIBERS_ID=

# Cloudinary — cloudinary.com (free tier: 25GB storage + bandwidth)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
